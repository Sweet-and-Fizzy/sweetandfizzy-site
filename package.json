{
  "name": "sweetandfizzy-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4329",
    "test": "node --test 'tests/*.test.mjs'",
    "check": "astro check && astro build && node scripts/check-dist.mjs",
    "sweep": "playwright test",
    "check:launch": "astro check && astro build && node scripts/check-dist.mjs --strict && playwright test"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
