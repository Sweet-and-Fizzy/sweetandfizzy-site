---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PaperCard from '../components/sections/PaperCard.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { brand } from '../data/colors';
import { mdInline } from '../lib/md';

const p = (await getEntry('publications', 'publications'))!.data;
const statColors = [brand.yellow, brand.blue, brand.orange];
---
<Base title={p.title} description={p.description}>
  <section class="page-hero" aria-labelledby="pb-title">
    <div class="wrap" style="padding-top: 80px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 48px">
      <div class="pb-top">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 780px; min-width: 0">
          <p class="eyebrow-xl" style="color: #fcee21">{p.hero.eyebrow}</p>
          <h1 id="pb-title" class="h1-xl">{p.hero.title}</h1>
          <p style="margin: 0; color: #c8c8c8">{p.hero.body}</p>
        </div>
        <svg class="pb-icon" aria-hidden="true" width="300" height="320" viewBox="0 0 300 320">
          <!-- A paper and an award medal, drawn like the agents hero: flat shapes, solid offset shadows.
               The text bars draw in, then the medal pops in. Plays once, under 2s; off with reduced motion. -->
          <path fill="#fcee21" d="M44 44h146l52 52v204H44z"></path>
          <path fill="#ffffff" d="M30 30h146l52 52v204H30z"></path>
          <path fill="#d6d6d6" d="M176 30v52h52z"></path>
          <g class="pb-bars" fill="#111111">
            <rect x="60" y="112" width="136" height="12"></rect>
            <rect x="60" y="136" width="112" height="12"></rect>
            <rect x="60" y="160" width="72" height="12"></rect>
          </g>
          <g class="pb-medal">
            <path fill="#ef4326" d="M200 262l-14 46 16-8 9 16 11-44z"></path>
            <path fill="#ef4326" d="M244 262l14 46-16-8-9 16-11-44z"></path>
            <circle cx="222" cy="244" r="38" fill="#5abdff"></circle>
            <circle cx="222" cy="244" r="24" fill="none" stroke="#ffffff" stroke-width="5"></circle>
          </g>
        </svg>
      </div>
      <dl class="stats">
        {p.stats.map((s, i) => <div><dt>{s.label}</dt><dd>{s.n}</dd><span class="sb" aria-hidden="true" style={`background: ${statColors[i % 3]}`}></span></div>)}
      </dl>
    </div>
  </section>

  <section aria-label="Papers" style="background: #ffffff">
    <div class="wrap" style="padding-top: 72px; padding-bottom: 32px">
      <p style="margin: 0; color: #595959">{p.note}</p>
    </div>
    {p.groups.map((g) => (
      <div class="wrap pb-group">
        <div class="pb-side">
          <div class="pb-tag" style={`--accent: ${brand[g.color]}`}><h2 class="h2-sec" style="color: #ffffff">{g.title}</h2></div>
          <p style="margin: 0">{g.blurb}</p>
          <a class="go-lk" href={g.link.href} style={`--accent: ${brand[g.color]}`}><span class="circ" aria-hidden="true"><Icon name="arrow-right" stroke={1.5} /></span><span class="x">{g.link.label}</span></a>
        </div>
        <ol class="pb-list">
          {g.papers.map((paper) => <li class="rv"><PaperCard paper={paper} /></li>)}
        </ol>
      </div>
    ))}
    <div class="wrap" style="padding-top: 16px; padding-bottom: 80px">
      <p class="prose-md" style="margin: 0; max-width: 760px" set:html={mdInline(p.more)} />
    </div>
  </section>

  <CtaBand title={p.cta.title} body={p.cta.body} button={p.cta.button} href="/contact/?audience=program" secondary={{ label: 'Planning a proposal?', href: '/planning-a-proposal/' }} />
</Base>

<style is:global>
  .pb-top{display:flex;align-items:center;justify-content:space-between;gap:64px}
  .pb-icon{display:block;flex:none}
  @media (prefers-reduced-motion:no-preference){
    .pb-bars rect{transform-box:fill-box;transform-origin:left center;animation:pb-draw .45s ease-out both}
    .pb-bars rect:nth-child(2){animation-delay:.2s}
    .pb-bars rect:nth-child(3){animation-delay:.4s}
    .pb-medal{transform-box:fill-box;transform-origin:center;animation:pb-pop .5s cubic-bezier(.3,1.6,.6,1) .9s both}
  }
  @keyframes pb-draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes pb-pop{from{transform:scale(0) rotate(-20deg)}to{transform:scale(1) rotate(0)}}
  @media (max-width:760px){.pb-top{flex-direction:column;align-items:flex-start}.pb-icon{width:150px;height:160px}}
  .pb-group{display:flex;flex-wrap:wrap;gap:32px 48px;align-items:flex-start;padding-top:32px;padding-bottom:48px}
  .pb-side{flex:1 1 280px;display:flex;flex-direction:column;gap:12px;min-width:0}
  .pb-tag{background:#111111;padding:16px 56px 18px 24px;margin-bottom:8px;clip-path:polygon(0 0,calc(100% - 32px) 0,100% 32px,100% 100%,0 100%);border-bottom:6px solid var(--accent)}
  .pb-list{flex:2 1 min(560px,100%);min-width:0;margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:32px}
</style>
