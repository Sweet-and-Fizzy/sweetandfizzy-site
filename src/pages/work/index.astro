---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getPhase1Work } from '../../data/work';
import AmpArt from '../../components/AmpArt.astro';

const work = await getPhase1Work();
---
<Base title="Case stories" description="How Sweet & Fizzy Digital helps research computing communities: ACCESS Support, the ACCESS AI Assistant, Open OnDemand and MGHPCC.">
  <section class="page-hero" aria-labelledby="st-title">
    <div class="wrap hero-in st-top" style="padding-top: 80px; padding-bottom: 88px">
      <div style="display: flex; flex-direction: column; gap: 20px; min-width: 0">
        <p class="eyebrow-xl" style="color: #5abdff">Case stories</p>
        <h1 id="st-title" class="h1-xl" style="max-width: 900px">How we help research computing communities</h1>
        <p style="margin: 0; color: #c8c8c8; max-width: 760px; font-size: clamp(20px, 2.4vw, 24px); line-height: 1.45">The goal, what we built, and where each project is today.</p>
      </div>
      <svg class="st-icon" aria-hidden="true" width="300" height="300" viewBox="0 0 300 300">
        <!-- The logo's ampersand in a speech bubble. The bubble's white outline gets the logo's 3D color
             offset: blue along the top and left, red along the right and bottom, yellow on the tail. -->
        <defs>
          <path id="st-b" d="M150 44 C 222 44 270 84 270 132 C 270 180 222 218 150 218 C 136 218 122 216 110 213 C 96 234 76 248 50 254 C 66 238 74 222 76 204 C 46 188 30 162 30 132 C 30 84 78 44 150 44 Z" fill="none" stroke-width="10" stroke-linejoin="round" stroke-linecap="round"></path>
          <clipPath id="st-cb"><polygon points="0,0 300,0 300,40 40,230 0,230"></polygon></clipPath>
          <clipPath id="st-cr"><polygon points="300,40 300,300 140,300 140,210 40,230"></polygon></clipPath>
          <clipPath id="st-cy"><polygon points="0,205 140,205 140,300 0,300"></polygon></clipPath>
        </defs>
        <g stroke="#5abdff" clip-path="url(#st-cb)"><use href="#st-b" transform="translate(0.8 0.8)"></use><use href="#st-b" transform="translate(1.6 1.6)"></use><use href="#st-b" transform="translate(2.4 2.4)"></use><use href="#st-b" transform="translate(3.2 3.2)"></use><use href="#st-b" transform="translate(4.0 4.0)"></use><use href="#st-b" transform="translate(4.8 4.8)"></use></g>
        <g stroke="#ef4326" clip-path="url(#st-cr)"><use href="#st-b" transform="translate(0.8 0.8)"></use><use href="#st-b" transform="translate(1.6 1.6)"></use><use href="#st-b" transform="translate(2.4 2.4)"></use><use href="#st-b" transform="translate(3.2 3.2)"></use><use href="#st-b" transform="translate(4.0 4.0)"></use><use href="#st-b" transform="translate(4.8 4.8)"></use></g>
        <g stroke="#fcee21" clip-path="url(#st-cy)"><use href="#st-b" transform="translate(0.8 0.8)"></use><use href="#st-b" transform="translate(1.6 1.6)"></use><use href="#st-b" transform="translate(2.4 2.4)"></use><use href="#st-b" transform="translate(3.2 3.2)"></use><use href="#st-b" transform="translate(4.0 4.0)"></use><use href="#st-b" transform="translate(4.8 4.8)"></use></g>
        <use href="#st-b" stroke="#ffffff"></use>
        <AmpArt x={97} y={80} size={106} />
      </svg>
    </div>
  </section>
  <section aria-label="Case stories" style="background: #ffffff">
    <div class="wrap st-grid" style="padding-top: 80px; padding-bottom: 96px">
      {work.map((w, i) => (
        <a class="cs rv" href={`/work/${w.id}/`} style={`--d: ${((i % 2) * 0.1).toFixed(1)}s; --accent: #5abdff`}>
          <span style="display: flex; flex-direction: column">
            <span class="shot" style="aspect-ratio: 16 / 10; border-bottom: 0">
              {w.data.card?.image ? <Pic src={w.data.card.image.src} alt="" sizes="(max-width: 760px) 100vw, 580px" widths={[580, 1160]} /> : <span class="ph-tile">[SCREENSHOT]</span>}
            </span>
            <span class="st-name">
              <span class="eyebrow-sm" style="color: #a6a6a6">Research computing</span>
              <span style="font-weight: 700; font-size: 26px; line-height: 1.15">{w.data.name}</span>
            </span>
          </span>
          <span style="color: #595959; max-width: 640px">{w.data.card?.line ?? w.data.title}</span>
          <span class="go-lk" style="margin-top: 4px"><span class="circ" aria-hidden="true"><Icon name="arrow-right" stroke={1.5} /></span><span class="x">Read the story</span></span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand title="Have something like this in mind?" body="Tell us about your program and what your community needs." button="Talk to us" href="/contact/?audience=program" secondary={{ label: 'See what we do', href: '/#research' }} />
</Base>
<style is:global>
  .st-top{display:flex;align-items:center;justify-content:space-between;gap:64px}
  .st-icon{display:block;flex:none}
  @media (max-width:760px){.st-top{flex-direction:column;align-items:flex-start}.st-icon{width:170px;height:170px}}
  .st-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:64px 32px}
  @media (max-width:760px){.st-grid{grid-template-columns:1fr}}
  .st-name{display:flex;flex-direction:column;gap:8px;padding:20px 24px;background:#111111;border-top:6px solid #5abdff;color:#ffffff}
  .cs .shot img{width:100%;height:100%;object-fit:cover;object-position:top center}
  .ph-tile{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:14px;color:#595959}
</style>
