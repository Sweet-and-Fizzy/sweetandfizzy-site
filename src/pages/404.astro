---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not on sweetandfizzy.com. Try the homepage, our case stories or the contact page." noindex>
  <section class="wrap" style="padding-top: 96px; padding-bottom: 120px; display: flex; flex-direction: column; gap: 20px; max-width: 760px">
    <p class="eyebrow-xl" style="color: #b4400f">404</p>
    <h1 class="h1-xl">That page is not here</h1>
    <p style="margin: 0; font-size: 20px">It may have moved when we rebuilt the site.</p>
    <ul class="flex-list" style="--accent: #5abdff">
      <li><a class="ul-lk" style="--accent: #5abdff" href="/">Homepage</a></li>
      <li><a class="ul-lk" style="--accent: #5abdff" href="/work/">Case stories</a></li>
      <li><a class="ul-lk" style="--accent: #5abdff" href="/contact/">Contact us</a></li>
    </ul>
  </section>
</Base>
