---
import { site } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img src="/img/logo.svg" alt="" width="227" height="40" />
    </a>
    <div class="head-actions">
      <a class="btn btn-sm nav-cta-mobile" href="/contact/">Contact us</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="main-nav">
        <Icon name="menu" size={20} stroke={2} />Menu
      </button>
    </div>
    <nav class="nav" id="main-nav" aria-label="Main">
      <div class="dd">
        <button type="button" class="dd-t" aria-expanded="false" aria-controls="services-menu">Services<Icon name="chevron" size={14} stroke={2.5} /></button>
        <div class="dd-m" id="services-menu">
          {site.services.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
        </div>
      </div>
      {site.nav.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a class="btn btn-sm" href="/contact/">Contact us</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('main-nav');
  const dd = document.querySelector<HTMLElement>('.dd');
  const ddBtn = dd?.querySelector<HTMLButtonElement>('.dd-t');
  const setMenu = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  };
  const setDd = (open: boolean) => ddBtn?.setAttribute('aria-expanded', String(open));
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  ddBtn?.addEventListener('click', () => setDd(ddBtn.getAttribute('aria-expanded') !== 'true'));
  dd?.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) setDd(false); });
  dd?.addEventListener('mouseleave', () => dd.classList.remove('esc'));
  document.addEventListener('click', (e) => { if (dd && !dd.contains(e.target as Node)) setDd(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (ddBtn && (ddBtn.getAttribute('aria-expanded') === 'true' || dd?.matches(':hover'))) {
      setDd(false); dd?.classList.add('esc'); ddBtn.focus(); return;
    }
    if (btn?.getAttribute('aria-expanded') === 'true') { setMenu(false); btn.focus(); }
  });
</script>
