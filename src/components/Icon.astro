---
// Inline stroke icons used across the boards. Always decorative.
interface Props { name: 'arrow-right' | 'arrow-down' | 'chevron' | 'menu'; size?: number; stroke?: number; class?: string }
const { name, size = 22, stroke = 1.75, class: cls } = Astro.props;
const paths = {
  'arrow-right': 'M3 12h18M14 5l7 7-7 7',
  'arrow-down': 'M12 4v16M5 13l7 7 7-7',
  chevron: 'M6 9l6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
};
---
<svg class={cls} aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"><path d={paths[name]}></path></svg>
