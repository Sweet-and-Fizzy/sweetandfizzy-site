---
import { site } from '../data/site';
---
<footer style="background: #111111; color: #ffffff; border-top: 1px solid #3a3a3a">
  <div class="wrap" style="padding-top: 56px; padding-bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 32px">
    <ul class="soc" style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 20px">
      <li><a href={site.social.github} aria-label="GitHub"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg></a></li>
      <li><a href={site.social.linkedin} aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 9h-3.4v11.5h3.4zM4.8 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM21 13.6c0-3.1-1.7-4.9-4.3-4.9-1.5 0-2.5.8-3 1.6V9h-3.3v11.5h3.4v-6.1c0-1.5.8-2.4 2-2.4s1.8.8 1.8 2.4v6.1H21z"></path></svg></a></li>
      <li><a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14"></rect><path d="M3 6l9 7 9-7"></path></svg></a></li>
    </ul>
    <nav aria-label="Footer"><ul class="fl" style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; justify-content: center; row-gap: 4px">
      {site.footer.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul></nav>
    <p style="margin: 0; font-size: 16px; color: #a6a6a6; text-align: center">© {new Date().getFullYear()} {site.name} · {site.city}<span class="ft-sep"> · </span><a class="ft-mail" href={`mailto:${site.email}`} style="color: #c8c8c8">{site.email}</a></p>
  </div>
</footer>
