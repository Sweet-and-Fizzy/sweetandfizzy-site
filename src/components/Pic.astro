---
// Responsive image. GIFs pass through untouched so animations survive.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; sizes?: string; widths?: number[]; loading?: 'lazy' | 'eager'; class?: string; style?: string }
const { src, alt, sizes = '(max-width: 860px) 100vw, 560px', widths = [480, 800, 1200], loading = 'lazy', class: cls, style } = Astro.props;
---
{src.format === 'gif' || src.format === 'svg'
  ? <img src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" class={cls} style={style} />
  : <Image src={src} alt={alt} widths={widths.filter((w) => w <= src.width).concat(widths.some((w) => w <= src.width) ? [] : [src.width])} sizes={sizes} loading={loading} class={cls} style={style} />}
