---
// Logos for programs, funders or supporters. Each item shows its logo file
// from src/assets/logos/ when given, otherwise its name as a text tile.
import Pic from '../Pic.astro';
import type { ImageMetadata } from 'astro';

interface Item { name: string; logo?: string; award?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*', { eager: true });
const logoFor = (file?: string) => (file ? logos[`/src/assets/logos/${file}`]?.default : undefined);
---
<ul class="logo-strip">
  {items.map((l) => (
    <li class="rv">
      <span class="logo-tile">{logoFor(l.logo) ? <Pic src={logoFor(l.logo)!} alt={l.name} sizes="200px" widths={[200, 400]} style="max-height: 64px; width: auto; height: auto; max-width: 100%" /> : <span class="logo-name">{l.name}</span>}</span>
      {l.award && <span class="logo-award">{l.award}</span>}
    </li>
  ))}
</ul>
<style is:global>
  .logo-strip{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:24px}
  .logo-strip li{display:flex;flex-direction:column;gap:8px}
  .logo-tile{height:112px;background:#ffffff;border:1px solid #d6d6d6;display:flex;align-items:center;justify-content:center;padding:16px 20px;text-align:center}
  .logo-name{font-weight:700;font-size:20px;line-height:1.2}
  .logo-award{font-size:14px;font-weight:700;letter-spacing:1px;color:#595959}
</style>
