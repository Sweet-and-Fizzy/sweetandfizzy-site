---
// One paper: venue, title, authors, optional summary, DOI link only when published.
interface Props { paper: { venue: string; title: string; authors: string; summary?: string; doi?: string }; boxed?: boolean }
const { paper: p, boxed = false } = Astro.props;
---
<div class:list={['paper-card', { boxed }]}>
  <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"></path><path d="M14 3v5h5"></path><path d="M8 13h8M8 17h5"></path></svg>
  <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0">
    <p class="eyebrow-sm">{p.venue}</p>
    <h3 class="paper-title">{p.title}</h3>
    <p style="margin: 0; font-size: 16px; color: #595959">{p.authors}</p>
    {p.summary && <p style="margin: 0; font-size: 16px">{p.summary}</p>}
    {p.doi && <a class="ul-lk doi-lk" href={`https://doi.org/${p.doi}`} style="--accent: #5abdff">doi.org/{p.doi}</a>}
  </div>
</div>
